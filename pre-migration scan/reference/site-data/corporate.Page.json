    "content": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap');\n\n  .corporate-card {\n    background: rgba(255,255,255,0.75); /* 50% silver */\n    border: 5px solid #363636;\n    border-radius: 10px;\n    padding: 20px 24px;\n    width: 100%;\n    box-sizing: border-box;\n    font-family: 'Montserrat', sans-serif;\n    color: #000000;\n    text-align: left;\n    line-height: 1.45;\n  }\n\n  .corporate-card__title {\n    font-size: 40px;\n    font-weight: 600;\n\ttext-align: center;\n    margin: 0 0 14px;\n  }\n\n  .corporate-card__body {\n    font-size: 20px;\n    font-weight: 400;\n\ttext-align: center;\n    margin: 0;\n  }\n\n  /* MOBILE OVERRIDES */\n  @media (max-width: 600px) {\n    .corporate-card__title {\n      font-size: 28px;\n    }\n    .corporate-card__body {\n      font-size: 15px;\n      line-height: 1.4;\n    }\n  }\n</style>\n\n<section class=\"corporate-card\" aria-labelledby=\"corporate-title\">\n  <h2 id=\"corporate-title\" class=\"corporate-card__title\">\n    Make your corporate event the <u>best one yet</u>!\n  </h2>\n  <p class=\"corporate-card__body\">\n    Treat your employees and guests to the most timeless form of entertainment: <b><i>live music!</i></b>\n     But this isn't just any live music; Reagan will customize his setlist to your event's\n    specific needs to create the exact type of environment you're looking for.\n  </p>\n</section>\n",
